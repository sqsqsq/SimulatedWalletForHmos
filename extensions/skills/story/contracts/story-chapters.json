{
  "sources": {
    "PRD": {
      "path": "RR/prd.md",
      "required": true,
      "label": "产品需求"
    },
    "SE": {
      "path": "SR/design.md",
      "required": true,
      "label": "系统设计"
    },
    "DESIGN": {
      "path": "AR/design.md",
      "required": true,
      "label": "开发需求"
    },
    "UPSTREAM": {
      "path": "AR/story-src/upstream.md",
      "required": false,
      "label": "上游澄清"
    }
  },
  "chapters": [
    {
      "id": "01-background",
      "title": "背景",
      "boundary": "分工归范围，机制归业务方案，可执行的通过条件归验收",
      "questions": [
        "现在这件事怎么做，哪里出了问题",
        "问题影响谁，对业务意味着什么",
        "本需求要改变什么，达到什么算成功",
        "本特性在完整需求里承担哪一段"
      ]
    },
    {
      "id": "02-terms",
      "title": "术语",
      "boundary": "功能规则归功能说明，完整字段契约归附录，方案介绍归业务方案",
      "questions": [
        "本需求出现的业务与技术术语各是什么意思",
        "实际会被读混的概念，差别与判别条件在哪"
      ],
      "structure": {
        "tables": [
          {"header": "术语|在本需求里的意思", "anchors": [["术语", "名词", "概念"]], "seed": "terms"}
        ]
      }
    },
    {
      "id": "03-scope",
      "title": "范围",
      "boundary": "运行时怎样协作归业务方案与业务流程，能力细节归功能说明，交付时点归交付与上线",
      "questions": [
        "整个需求不做什么",
        "本部件不负责但其他部件仍需完成什么",
        "哪些依赖阻塞本部件，哪些独立排期",
        "本 AR 承载哪部分、兄弟 AR 各承载什么、边界在哪、有无先后依赖"
      ]
    },
    {
      "id": "04-solution",
      "title": "业务方案",
      "boundary": "执行过程归业务流程，局部规则归功能说明",
      "questions": [
        "全部参与系统及各自输入、输出、责任与失败影响",
        "业务结果以谁为准、重要业务规则是什么",
        "每个关键取舍：选了什么、依据是什么；有真实备选时否了什么、为什么不行",
        "全篇的风险：触发条件、影响、已有控制——风险只在这一章成表，别的章不重复"
      ]
    },
    {
      "id": "05-flow",
      "title": "业务流程",
      "boundary": "能力内部规则归功能说明，详细恢复归异常与恢复",
      "questions": [
        "从触发到终态的完整过程与主要阶段",
        "主路径及全部分支去向（开关、登录态、风控、网络、回调等）与交接点——总览给主线与主要分流入口，复杂分支在对应小节完整展开并接回主线",
        "关键状态变化与终态"
      ],
      "structure": {
        "diagram": true
      }
    },
    {
      "id": "06-features",
      "title": "功能说明",
      "boundary": "跨能力过程归业务流程，精确接口与完整字段清单归附录",
      "questions": [
        "本特性提供哪些能力，各自在什么输入与条件下工作",
        "每项能力按什么规则处理，数据与状态怎样变化",
        "结果是什么、谁看得见，受限时怎样继续"
      ]
    },
    {
      "id": "07-exceptions",
      "title": "异常与恢复",
      "boundary": "整体风险归业务方案，正常过程归业务流程，特性的交付停用归交付与上线",
      "questions": [
        "哪些是设计内的受限结果，哪些是真正的异常",
        "各自的影响、可观察结果与恢复方式是什么"
      ]
    },
    {
      "id": "08-acceptance",
      "title": "验收",
      "boundary": "规则的定义归业务流程、功能说明与异常与恢复",
      "questions": [
        "完整需求怎样才算完成",
        "每条原始验收编号的场景、可观察通过条件与主责",
        "质量指标是什么，来源是上游约束还是工程设定",
        "上线后看哪些指标、每个怎么算"
      ],
      "structure": {
        "tables": [
          {"header": "编号|验收点|可观察的通过条件",
           "anchors": [["编号"], ["通过条件", "通过判据", "算通过", "算完成"]], "seed": "table"}
        ]
      }
    },
    {
      "id": "09-rollout",
      "title": "交付与上线",
      "review_status": "审查状态",
      "boundary": "每项功能归功能说明，异常处理归异常与恢复",
      "questions": [
        "真实依赖接入、相关特性联调与开放顺序是什么",
        "每个可独立控制的对象怎样启用、停用、回退与恢复，控制到哪为止，进行中的业务受什么影响",
        "交付物有哪些、给谁、什么时候要"
      ],
      "structure": {
        "h3": [{"title": "交付物"}],
        "tables": [
          {"header": "交付物|给谁|做什么用|什么时候要", "at": "交付物", "seed": "table",
           "anchors": [["交付物", "交付件"], ["给谁", "接收方", "谁在等"],
                       ["做什么用", "用途", "拿去做什么"]]}
        ]
      }
    },
    {
      "id": "10-appendix",
      "title": "附录",
      "appendix": true,
      "boundary": "理解型叙述归正文各章，字段与规则的真源归已准入蓝图的契约、运行数据流、知识应用决定与精确明细，材料归冻结的设计输入",
      "subsections": [
        "技术契约",
        "规约",
        "埋点",
        "改动边界",
        "材料清单"
      ],
      "questions": [
        "接口、存储、配置、统计点各自的约定与触发时机",
        "数据的用途、有效期、隔离、清理与安全处置",
        "每个规约条目命中与否及依据"
      ],
      "projection": {
        "sections": {
          "技术契约": {"h4": [
            {"title": "端云接口", "reader": "contracts",
             "tables": {"fields": "位置|字段|类型|含义|可空", "mappings": "映射|目标字段|方式|来源字段|规则"},
             "labels": {"request": "请求", "response": "响应", "nullable": "可空", "required": "必有", "version": "版本",
                        "errors": "错误语义", "idempotency": "幂等", "nfr": "非功能"}},
            {"title": "数据存储", "reader": "data_flows", "detail_kind": "data_policy",
             "tables": {"flows": "数据流|数据域|权威来源|状态归属|失败与恢复"},
             "labels": {"authority": "权威", "persistence": "持久化", "projections_and_caches": "投影与缓存", "reconciliation": "对账",
                        "ref": "归属", "states": "状态", "recovery_id": "恢复编号", "persistence_failure": "写入失败",
                        "subscription_failure": "订阅失败", "process_recreation": "进程重建"}},
            {"title": "配置项", "reader": "details", "detail_kind": "configuration"}
          ]},
          "规约": {"reader": "knowledge_applications", "tables": {"rows": "知识单元|判定|要求与理由|落点"}},
          "埋点": {"reader": "details", "detail_kind": "event"},
          "改动边界": {"reader": "change_boundary", "tables": {"rows": "模块|本单怎么动"},
                       "labels": {"unchanged": "开发视图不变"}}
        }
      },
      "material_roles": {"original": "原件", "image": "图片", "human_record": "人签记录", "extracted_analysis": "派生分析（提取稿）"}
    }
  ],
  "id_shapes": {
    "acceptance": ["AC-[A-Z]?\\d+", "BD-[A-Z]?\\d+"],
    "function": ["F\\d+"],
    "keep": [
      "AC-[A-Z]?\\d+"
    ],
    "drop": [
      "\\bS\\d+\\b",
      "\\bF\\d+\\b",
      "\\bE\\d+\\b",
      "\\bBD-\\d+\\b"
    ]
  },
  "language_redline": {
    "kinds": [
      "repo_identifier",
      "rule_id",
      {
        "kind": "doc_coordinate",
        "scope": "all"
      },
      "source_tag"
    ],
    "source_tags": [
      "本工程设定",
      "工程设定",
      "上游约束",
      "上游已定",
      "本文设定"
    ]
  },
  "verdicts": {
    "chapter_dimensions": [
      "业务过程与本特性功能分开说明",
      "正常受限结果与真正异常分开说明",
      "取舍写清了依据，有真实备选时写清被否方案与理由",
      "标题是真实业务名、层级反映真实从属",
      "表达贴合内容（能一句话说清的不建表、流程用图、不是通篇表格靠连接词串起来、一格里不塞一串分号短语）",
      "每张图前讲过程、图后讲分支：图前把谁在什么条件下做什么、结果怎样讲一遍，不看图也懂；图后说明各分支成立的条件、由谁处理及处理结果；单一路径的图一句话说明后续去向",
      "第一次接触的人读完能答出「为什么做 / 怎么做 / 哪里会坏 / 怎么算对」",
      "同一件事只在一处完整表述——本章与其它章没有成段重复；图讲关系、表讲属性、文字讲理由算互补，验收独立判所必需的条件与数值重现也算必要，都不算重复"
    ]
  },
  "decision_categories": [
    {"key": "范围与交付"},
    {"key": "业务规则"},
    {"key": "交互与界面"},
    {"key": "数据与隐私"},
    {"key": "依赖与承载"},
    {"key": "上线与开关"},
    {"key": "质量指标"}
  ],
  "gates": {
    "material_scope": {
      "options": [
        {"key": "supplied", "label": "材料已放进 doc/features/<单>/inbox/，请导入", "request": true},
        {"key": "confirm_scope", "label": "现有材料就是全部，开始需求分析"}
      ]
    }
  },
  "flow": {
    "schema": 5,
    "gates": ["material_scope", "scope_decision", "split_carrier", "meeting"],
    "carry_all": "carry_all"
  },
  "update_files": {
    "editable": ["AR/story.md", "AR/story-src/design-draft.md", "AR/story-src/design-input.json",
      "AR/story-src/decisions.json", "AR/story-src/story-template.md", "AR/story-src/doc-refresh.md",
      "AR/story-src/drafts/**"],
    "regenerate": ["AR/review.md", "AR/story-src/materials.json"],
    "protected": ["RR/**", "SR/**", "AR/design.md", "AR/detail.json", "inbox/**", "assets/**", "ux-reference/**",
      "AR/story-src/meetings/**", "AR/story-src/inputs/**", "AR/story-src/review/**", "AR/story-src/updates/**",
      ".backups/**"],
    "field_owned": ["AR/story-src/story-flow.json"]
  },
