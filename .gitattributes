# Line endings: LF in the Git index and working tree (cross-platform default).
# After editing this file, run: git add --renormalize .
# Ref: https://git-scm.com/docs/gitattributes

*.md   text eol=lf
*.mdc  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.ets  text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf
*.py     text eol=lf
*.toml   text eol=lf
*.sha256 text eol=lf

