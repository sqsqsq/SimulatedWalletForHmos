{
  "version": "4.0",
  "sources": {
    "PRD": {
      "path": "RR/prd.md",
      "required": true,
      "label": "产品需求"
    },
    "SE": {
      "path": "SR/design.md",
      "required": true,
      "label": "系统设计"
    },
    "SPEC": {
      "path": "spec/spec.md",
      "derived": true,
      "required": true,
      "label": "本轮规格"
    },
    "DESIGN": {
      "path": "AR/design.md",
      "required": true,
      "label": "开发需求"
    },
    "UPSTREAM": {
      "path": "AR/story-src/upstream.md",
      "required": false,
      "label": "上游澄清"
    }
  },
  "chapters": [
    {
      "id": "01-background",
      "title": "背景",
      "boundary": "讲动机与目标；分工归范围，机制归业务方案，可执行的通过条件归验收",
      "questions": [
        "现在这件事怎么做，哪里出了问题",
        "问题影响谁，对业务意味着什么",
        "本需求要改变什么，达到什么算成功",
        "本特性在完整需求里承担哪一段"
      ]
    },
    {
      "id": "02-terms",
      "title": "术语",
      "boundary": "解释概念；不承担功能规则、完整字段契约、方案介绍；后文沿用同名同义",
      "questions": [
        "本需求出现的业务与技术术语各是什么意思",
        "实际会被读混的概念，差别与判别条件在哪"
      ],
      "structure": {
        "tables": [
          {"header": "术语|在本需求里的意思", "anchors": [["术语", "名词", "概念"]], "seed": "terms"}
        ]
      }
    },
    {
      "id": "03-scope",
      "title": "范围",
      "boundary": "讲责任与交付边界；运行时怎样协作归方案与流程，能力细节归功能说明，交付时点归上线",
      "questions": [
        "整个需求不做什么",
        "本部件不负责但其他部件仍需完成什么",
        "哪些依赖阻塞本部件，哪些独立排期",
        "本 AR 承载哪部分、兄弟 AR 各承载什么、边界在哪、有无先后依赖"
      ]
    },
    {
      "id": "04-solution",
      "title": "业务方案",
      "boundary": "讲整体机制与为什么这样选；流程展开执行过程，功能说明展开局部规则；风险只在这一章成表",
      "questions": [
        "全部参与系统及各自输入、输出、责任与失败影响",
        "业务结果以谁为准、重要业务规则是什么",
        "每个关键取舍：选了什么、依据是什么；有真实备选时否了什么、为什么不行",
        "全篇的风险：触发条件、影响、已有控制——风险只在这一章成表，别的章不重复"
      ]
    },
    {
      "id": "05-flow",
      "title": "业务流程",
      "boundary": "讲能力之间的顺序、条件与连接；能力内部规则归功能说明，详细恢复归异常；异常在总览有去向",
      "questions": [
        "从触发到终态的完整过程与主要阶段",
        "主路径及全部分支去向（开关、登录态、风控、网络、回调等）与交接点——总览给主线与主要分流入口，复杂分支在对应小节完整展开并接回主线",
        "关键状态变化与终态"
      ],
      "structure": {
        "diagram": true
      }
    },
    {
      "id": "06-features",
      "title": "功能说明",
      "boundary": "讲局部能力的行为；跨能力过程归流程，精确接口与完整字段清单归附录；正文只讲理解行为需要的数据含义",
      "questions": [
        "本特性提供哪些能力，各自在什么输入与条件下工作",
        "每项能力按什么规则处理，数据与状态怎样变化",
        "结果是什么、谁看得见，受限时怎样继续"
      ]
    },
    {
      "id": "07-exceptions",
      "title": "异常与恢复",
      "boundary": "讲运行失败后的行为与恢复；整体风险归方案，正常过程归流程，特性的交付停用归上线",
      "questions": [
        "哪些是设计内的受限结果，哪些是真正的异常",
        "各自的影响、可观察结果与恢复方式是什么"
      ]
    },
    {
      "id": "08-acceptance",
      "title": "验收",
      "boundary": "验证已定义的行为，不重新定义规则；必要地重现关键数值与条件以便独立验收，与正文一致",
      "questions": [
        "完整需求怎样才算完成",
        "每条原始验收编号的场景、可观察通过条件与主责",
        "质量指标是什么，来源是上游约束还是工程设定",
        "上线后看什么指标、由哪条流程算出"
      ],
      "structure": {
        "tables": [
          {"header": "编号|验收点|可观察的通过条件",
           "anchors": [["编号"], ["通过条件", "通过判据", "算通过", "算完成"]], "seed": "table"}
        ]
      }
    },
    {
      "id": "09-rollout",
      "title": "交付与上线",
      "boundary": "讲交付与运行管控；不重复每项功能与异常处理",
      "questions": [
        "真实依赖接入、相关特性联调与开放顺序是什么",
        "每个可独立控制的对象怎样启用、停用与恢复，存量和在途业务受什么影响",
        "交付物有哪些、给谁、什么时候要"
      ],
      "banned_terms_exempt": true,
      "structure": {
        "h3": [{"title": "交付物"}],
        "tables": [
          {"header": "交付物|给谁|做什么用|什么时候要", "at": "交付物", "seed": "table",
           "anchors": [["交付物", "交付件"], ["给谁", "接收方", "谁在等"],
                       ["做什么用", "用途", "拿去做什么"]]}
        ]
      }
    },
    {
      "id": "10-appendix",
      "title": "附录",
      "appendix": true,
      "boundary": "登记处：主叙事里的中文名在这里对应到接口、字段与条目，供按名查证；机器区只由 spec §9 与知识判断投影，作者区写说明，不维护第二份字段或规则；材料清单只解释来源贡献，不收纳正文",
      "subsections": [
        "技术约定",
        "改动边界",
        "规约判定",
        "材料清单"
      ],
      "questions": [
        "接口、存储、配置、统计点各自的约定与触发时机",
        "数据的用途、有效期、隔离、清理与安全处置",
        "每个规约条目命中与否及依据"
      ],
      "projection": {
        "drop_columns": ["代码现状"],
        "sections": {
          "技术约定": {"h4": [
            {"title": "接口", "from": "9.1", "rename": {"云侧接口": "接口", "新增·复用·变更": "性质", "入参 → 出参": "输入 → 输出"}},
            {"title": "数据", "from": "9.2"},
            {"title": "配置", "from": "9.3"},
            {"title": "埋点", "from": "9.4", "whole": true, "rename": {"统计点（步骤/子点）": "统计点"}}
          ]},
          "改动边界": {"kind": "scope", "from": "9.5"},
          "规约判定": {"kind": "knowledge_use"}
        }
      },
      "subsection_tables": {"改动边界": "模块|本单怎么动", "规约判定": "规约域|编号|判定|依据"}
    }
  ],
  "id_shapes": {
    "keep": [
      "AC-[A-Z]?\\d+"
    ],
    "drop": [
      "\\bS\\d+\\b",
      "\\bF\\d+\\b",
      "\\bE\\d+\\b",
      "\\bBD-\\d+\\b",
      "DEC-\\d+"
    ]
  },
  "language_redline": {
    "scope": "non_appendix",
    "kinds": [
      "repo_identifier",
      "rule_id",
      {
        "kind": "doc_coordinate",
        "scope": "all"
      },
      "source_tag"
    ],
    "source_tags": [
      "本工程设定",
      "工程设定",
      "上游约束",
      "上游已定",
      "本文设定"
    ],
    "client_vocabulary": [
      {
        "term": "灰度",
        "hint": "改说「功能开关管控」或「按批次放量」"
      },
      {
        "term": "部署",
        "hint": "客户端无部署概念，改说「随版本发布」"
      },
      {
        "term": "集群",
        "hint": "服务器侧概念，端侧不涉及"
      },
      {
        "term": "QPS",
        "hint": "改说「端云接口请求量与触发频次」"
      },
      {
        "term": "TPS",
        "hint": "同 QPS"
      },
      {
        "term": "熔断",
        "hint": "服务器侧概念"
      },
      {
        "term": "限流",
        "hint": "服务器侧概念；端侧防重入请写「防抖/幂等」"
      }
    ]
  },
  "verdicts": {
    "chapter_dimensions": [
      "业务过程与本特性功能分开说明",
      "正常受限结果与真正异常分开说明",
      "取舍写清了依据，有真实备选时写清被否方案与理由",
      "标题是真实业务名、层级反映真实从属",
      "表达贴合内容（能一句话说清的不建表、流程用图、不是通篇表格靠连接词串起来）",
      "每张图前讲过程、图后讲判断：图前把谁在什么条件下做什么、结果怎样讲一遍，不看图也懂；图后逐条讲分支里读者要知道的条件、责任、后果；只有一条路径的图一句收束",
      "第一次接触的人读完能答出「为什么做 / 怎么做 / 哪里会坏 / 怎么算对」",
      "同一件事只在一处完整表述——本章与其它章没有成段重复；图讲关系、表讲属性、文字讲理由算互补，验收独立判所必需的条件与数值重现也算必要，都不算重复"
    ]
  },
  "review_form_banned_lines": [
    {"name": "如何填写", "pattern": "^#{1,6}?\\s*\\**\\s*(?:如何填写|填写说明|使用说明)"},
    {"name": "确认人", "pattern": "^[-*]?\\s*\\**确认人\\**\\s*[:：]"},
    {"name": "确认日期", "pattern": "^[-*]?\\s*\\**确认日期\\**\\s*[:：]"},
    {"name": "确认依据", "pattern": "^[-*]?\\s*\\**确认依据\\**\\s*[:：]"},
    {"name": "状态行", "pattern": "^[-*]?\\s*\\**状态\\**\\s*[:：]"},
    {"name": "下一步", "pattern": "^#{1,6}?\\s*\\**\\s*下一步\\**\\s*[:：]?\\s*$"}
  ],
